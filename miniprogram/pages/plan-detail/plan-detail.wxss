.detail-page { min-height:100vh; padding:calc(88rpx + env(safe-area-inset-top)) 32rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing:border-box; color:#15231e; background:radial-gradient(circle at 88% 4%, rgba(233,179,93,.34) 0, rgba(233,179,93,0) 24%), radial-gradient(ellipse at 4% 76%, rgba(74,139,106,.25) 0, rgba(74,139,106,0) 42%), linear-gradient(180deg, #e6f0df 0%, #f2f4e6 50%, #fbf0df 100%); }
.simple-topbar { display:flex; align-items:center; justify-content:space-between; min-height:88rpx; }
.location-link { display:flex; align-items:center; gap:8rpx; padding:10rpx 14rpx; border:2rpx solid #dfe6de; border-radius:999rpx; background:#fff; color:#176b4e; font-size:23rpx; font-weight:700; }
.location-dot { width:12rpx; height:12rpx; border-radius:50%; background:#39a268; }
.detail-heading { margin-top:18rpx; padding:30rpx 28rpx; border-radius:18rpx; background:#0e382b; color:#f3f7ef; box-shadow:0 12rpx 28rpx rgba(14,56,43,.16); }
.eyebrow { margin-bottom:10rpx; color:#d47745; font-size:28rpx; font-weight:900; letter-spacing:3rpx; }
.detail-heading .eyebrow { margin-bottom:12rpx; color:#dba470; font-size:22rpx; }
.detail-title { color:#f3f7ef; font-size:46rpx; font-weight:900; letter-spacing:-2rpx; line-height:1.15; }
.detail-summary { display:-webkit-box; overflow:hidden; margin-top:14rpx; color:rgba(243,247,239,.76); font-size:24rpx; line-height:1.6; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.detail-source { margin-top:14rpx; color:#c7dfc2; font-size:20rpx; }
.notice-line { margin-top:18rpx; padding:14rpx 16rpx; border-radius:12rpx; background:#fff2e9; color:#a76225; font-size:22rpx; line-height:1.5; }
.fact-row { display:flex; gap:10rpx; margin-top:16rpx; padding:18rpx; border:2rpx solid #dfe6de; border-radius:16rpx; background:rgba(255,255,255,.88); }
.fact-row > view { display:flex; min-width:0; flex:1; flex-direction:column; gap:5rpx; }
.fact-row text { color:#8b9690; font-size:20rpx; }
.fact-row .fact-value { overflow:hidden; color:#15231e; font-size:28rpx; font-weight:900; text-overflow:ellipsis; white-space:nowrap; }
.detail-section { margin-top:16rpx; padding:22rpx; border-radius:16rpx; background:rgba(255,255,255,.9); border:2rpx solid rgba(223,230,222,.9); }
.section-title { color:#15231e; font-size:30rpx; font-weight:900; }
.confirm-list { margin-top:12rpx; }
.confirm-list view { padding:7rpx 0; color:#617069; font-size:23rpx; line-height:1.5; }
.confirm-list text { margin-right:8rpx; color:#d47745; font-weight:900; }
.page .change-time-link { width:auto; min-height:46rpx; margin:12rpx 0 0; padding:0; border:0; background:transparent; color:#176b4e; font-size:22rpx; font-weight:800; }
.change-time-link text { margin-left:4rpx; color:#d47745; }
.schedule-list { margin-top:12rpx; }
.schedule-item { display:flex; gap:14rpx; padding:12rpx 0; border-bottom:2rpx solid #edf1ec; }
.schedule-item:last-child { border-bottom:0; }
.schedule-time { width:86rpx; flex:0 0 86rpx; color:#d47745; font-size:17rpx; font-weight:800; }
.schedule-item > view { display:flex; min-width:0; flex-direction:column; gap:3rpx; }
.schedule-item .schedule-title { color:#15231e; font-size:24rpx; font-weight:900; }
.schedule-item > view text { color:#617069; font-size:22rpx; line-height:1.5; }
.detail-actions { display:flex; gap:10rpx; margin-top:18rpx; }
.page .detail-actions button { flex:1; min-height:68rpx; margin:0; border-radius:999rpx; font-size:24rpx; font-weight:900; }
.secondary-button { border:2rpx solid #dfe6de; background:#fff; color:#176b4e; }
.primary-button { background:#176b4e; color:#fff; }
.primary-button.saved { background:#dceee0; color:#176b4e; }
.empty-state { padding:120rpx 20rpx; text-align:center; }
.empty-title { color:#15231e; font-size:30rpx; font-weight:900; }
.page .empty-state .primary-button { min-height:64rpx; margin:24rpx auto 0; padding:0 28rpx; border-radius:999rpx; font-size:23rpx; font-weight:800; }
.sheet-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:100; display:flex; align-items:flex-end; justify-content:center; background:rgba(21,35,30,.28); }
.departure-sheet { width:100%; padding:28rpx 32rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius:24rpx 24rpx 0 0; background:#fff; box-sizing:border-box; }
.sheet-title { color:#15231e; font-size:30rpx; font-weight:900; }
.departure-quick-list { display:flex; gap:10rpx; margin-top:20rpx; }
.page .departure-chip { flex:1; min-height:58rpx; margin:0; border:2rpx solid #dfe6de; border-radius:999rpx; background:#fbfaf6; color:#176b4e; font-size:23rpx; font-weight:700; }
.picker-row { display:flex; gap:12rpx; margin-top:16rpx; }
.picker-box { display:flex; flex:1; align-items:center; justify-content:space-between; padding:18rpx; border-radius:12rpx; background:#f5f7f2; color:#8b9690; font-size:22rpx; }
.picker-box picker { color:#15231e; font-weight:800; }
.sheet-actions { display:flex; gap:12rpx; margin-top:20rpx; }
.page .sheet-cancel, .page .sheet-confirm { flex:1; min-height:66rpx; margin:0; border-radius:999rpx; font-size:24rpx; font-weight:800; }
.sheet-cancel { border:2rpx solid #dfe6de; background:#fff; color:#617069; }
.sheet-confirm { background:#176b4e; color:#fff; }
@media (max-width:360px) { .detail-page { padding-right:20rpx; padding-left:20rpx; } .detail-title { font-size:40rpx; } .detail-section { padding:18rpx; } }
