<view class="page home-page">
  <view class="simple-topbar">
    <view class="brand-lockup"><view class="brand-symbol">野</view><view class="brand-copy"><text class="brand-name">野去</text><text class="brand-tagline">找到今天适合的路</text></view></view>
  </view>

  <view class="home-heading"><view class="eyebrow">周末去哪</view><view class="home-title">找条合适的路</view><view class="home-subtitle">输入需求，开始找路线。</view></view>

  <view class="search-box">
    <view class="search-panel-heading"><text class="panel-kicker">找路线</text><text class="character-count">{{form.query.length || 0}}/120</text></view>
    <textarea class="intent-input" value="{{form.query}}" maxlength="120" auto-height placeholder="输入需求" bindinput="onSearchInput" bindconfirm="searchRoutes" />
    <view class="search-panel-footer"><view class="quick-row"><block wx:for="{{quickSearchOptions}}" wx:key="label"><button class="quick-chip {{item.active ? 'active' : ''}}" data-value="{{item.label}}" bindtap="applyQuickSearch">{{item.label}}</button></block></view><button class="primary-search" bindtap="searchRoutes">找路线 <text>→</text></button></view>
  </view>

  <view class="context-row">
    <view class="context-item" bindtap="openOriginPicker"><text class="context-label">出发地</text><text class="context-value">{{originDisplayName === '选择出发地' ? '选择地点' : originDisplayName}}</text><text class="context-action">更改</text></view>
    <view class="context-item" bindtap="openDeparturePicker"><text class="context-label">时间</text><text class="context-value">{{departureSummary}}</text><text class="context-action">更改</text></view>
  </view>

  <view class="home-links"><view class="filter-link" bindtap="toggleAdvancedFilters">{{showAdvancedFilters ? '收起筛选' : '更多筛选'}} <text>{{showAdvancedFilters ? '↑' : '↓'}}</text></view><view class="share-link" bindtap="openUploadRoute">分享路线 <text>↗</text></view></view>

  <view wx:if="{{showAdvancedFilters}}" class="filters-panel">
    <view class="filter-field"><text>年龄</text><view class="filter-options"><block wx:for="{{ageRangeOptions}}" wx:key="*this"><button class="option-chip {{form.ageRange === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectAge">{{item}}</button></block></view></view>
    <view class="filter-field"><text>时长</text><view class="filter-options"><block wx:for="{{durationOptions}}" wx:key="*this"><button class="option-chip {{form.duration === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectDuration">{{item}}</button></block></view></view>
    <view class="filter-field"><text>难度</text><view class="filter-options"><block wx:for="{{difficultyOptions}}" wx:key="*this"><button class="option-chip {{form.difficulty === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectDifficulty">{{item}}</button></block></view></view>
    <view class="filter-field"><text>交通</text><view class="filter-options"><block wx:for="{{transportOptions}}" wx:key="*this"><button class="option-chip {{form.transport === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectTransport">{{item}}</button></block></view></view>
    <view class="filter-field"><text>车程</text><view class="filter-options"><block wx:for="{{driveLimitOptions}}" wx:key="*this"><button class="option-chip {{form.driveLimit === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectDriveLimit">{{item}}</button></block></view></view>
    <view class="filter-field"><text>场景</text><view class="filter-options"><block wx:for="{{scenePreferenceOptions}}" wx:key="*this"><button class="option-chip {{form.scenePreferences.indexOf(item) >= 0 ? 'active' : ''}}" data-value="{{item}}" bindtap="toggleScene">{{item}}</button></block></view></view>
    <view class="filter-field"><text>需要</text><view class="filter-options"><block wx:for="{{safetyNeedOptions}}" wx:key="*this"><button class="option-chip {{form.safetyNeeds.indexOf(item) >= 0 ? 'active' : ''}}" data-value="{{item}}" bindtap="toggleSafety">{{item}}</button></block></view></view>
  </view>

  <view wx:if="{{showDeparturePicker}}" class="sheet-mask" bindtap="closeDeparturePicker">
    <view class="departure-sheet" catchtap="noop"><view class="sheet-title">出发时间</view><view class="departure-quick-list"><button class="departure-chip" data-value="NOW" bindtap="selectQuickDeparture">现在</button><button class="departure-chip" data-value="TODAY_PM" bindtap="selectQuickDeparture">今天下午</button><button class="departure-chip" data-value="TOMORROW_AM" bindtap="selectQuickDeparture">明天上午</button></view><view class="picker-row"><view class="picker-box"><text>日期</text><picker mode="date" value="{{customDepartureDate}}" bindchange="onDepartureDateChange"><view>{{customDepartureDate}}</view></picker></view><view class="picker-box"><text>时间</text><picker mode="time" value="{{customDepartureTime}}" bindchange="onDepartureTimeChange"><view>{{customDepartureTime}}</view></picker></view></view><view class="sheet-actions"><button class="sheet-cancel" bindtap="closeDeparturePicker">取消</button><button class="sheet-confirm" bindtap="confirmCustomDeparture">确定</button></view></view>
  </view>
</view>
