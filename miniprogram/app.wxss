page {
  min-height: 100vh;
  background: #edf4ed;
  color: #15231e;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", Arial, sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

button {
  display: flex;
  width: auto;
  min-width: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding-top: 0;
  padding-bottom: 0;
  line-height: normal;
}

button::after {
  border: 0;
}

input,
textarea {
  box-sizing: border-box;
}

/* Shared compact brand/header grammar used by every task view. */
.page .simple-topbar {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
}

.page .brand-lockup {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.page .brand-symbol {
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: #0e382b;
  color: #eef6e9;
  font-family: serif;
  font-size: 26rpx;
  font-weight: 900;
}

.page .brand-copy {
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.page .brand-name {
  color: #15231e;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
}

.page .brand-tagline {
  color: #8b9690;
  font-size: 19rpx;
  line-height: 1.2;
}

.page .brand-lockup.compact .brand-symbol {
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.page .brand-lockup.compact .brand-name {
  font-size: 26rpx;
}

.page .brand-lockup.compact .brand-tagline {
  font-size: 18rpx;
}

.page .back-link {
  width: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #d47745;
  font-size: 44rpx;
  font-weight: 400;
}

.page .back-link:active {
  opacity: .72;
}
